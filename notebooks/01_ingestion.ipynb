   "source": [
    "# Warstwa 1: Ingestion — Pobieranie danych z YouTube API\n",
    "\n",
    "**Cel:** Pobranie danych o trendujących filmach z YouTube dla 5 regionów (PL, US, GB, DE, FR)  \n",
    "**Formaty wyjściowe:** JSON (surowy), CSV (płaski), Parquet (kolumnowy)\n",
    "\n",
    "## Jak uzyskać klucz API?\n",
    "1. Wejdź na [console.cloud.google.com](https://console.cloud.google.com)\n",
    "2. APIs & Services → Enable APIs → wyszukaj **YouTube Data API v3** → Enable\n",
    "3. APIs & Services → Credentials → Create Credentials → API Key\n",
    "4. Skopiuj klucz i wpisz go poniżej\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Konfiguracja OK\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import json\n",
    "import time\n",
    "from datetime import datetime\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "import pyarrow as pa\n",
    "import pyarrow.parquet as pq\n",
    "from googleapiclient.discovery import build\n",
    "from tqdm.notebook import tqdm\n",
    "\n",
    "# ── Konfiguracja ──────────────────────────────────────────────────────────────\n",
    "API_KEY = \"?"   # <-- zmień na swój klucz\n",
    "\n",
    "REGIONS   = [\"PL\", \"US\", \"GB\", \"DE\", \"FR\"]\n",
    "MAX_PAGES = 4          # 50 filmów na stronę × 4 = 200 filmów na region\n",
    "\n",
    "RAW_DIR     = Path(\"../data/raw\")\n",
    "PARQUET_DIR = Path(\"../data/parquet\")\n",
    "RAW_DIR.mkdir(parents=True, exist_ok=True)\n",
    "PARQUET_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "CATEGORY_MAP = {\n",
    "    \"1\":  \"Film & Animation\", \"2\":  \"Autos & Vehicles\",\n",
    "    \"10\": \"Music\",            \"15\": \"Pets & Animals\",\n",
    "    \"17\": \"Sports\",           \"19\": \"Travel & Events\",\n",
    "    \"20\": \"Gaming\",           \"22\": \"People & Blogs\",\n",
    "    \"23\": \"Comedy\",           \"24\": \"Entertainment\",\n",
    "    \"25\": \"News & Politics\",  \"26\": \"Howto & Style\",\n",
    "    \"27\": \"Education\",        \"28\": \"Science & Technology\",\n",
    "    \"29\": \"Nonprofits & Activism\"\n",
    "}\n",
    "\n",
    "print(\"Konfiguracja OK\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Funkcja fetch_trending gotowa\n"
     ]
    }
   ],
   "source": [
    "def fetch_trending(youtube, region_code: str, max_pages: int) -> list[dict]:\n",
    "    \"\"\"Pobiera trendujące filmy dla danego regionu.\"\"\"\n",
    "    videos = []\n",
    "    next_page_token = None\n",
    "\n",
    "    for _ in range(max_pages):\n",
    "        req = youtube.videos().list(\n",
    "            part=\"snippet,statistics,contentDetails,status\",\n",
    "            chart=\"mostPopular\",\n",
    "            regionCode=region_code,\n",
    "            maxResults=50,\n",
    "            pageToken=next_page_token\n",
    "        )\n",
    "        resp = req.execute()\n",
    "\n",
    "        for item in resp.get(\"items\", []):\n",
    "            snippet    = item.get(\"snippet\", {})\n",
    "            stats      = item.get(\"statistics\", {})\n",
    "            content    = item.get(\"contentDetails\", {})\n",
    "\n",
    "            videos.append({\n",
    "                # identyfikatory\n",
    "                \"video_id\":           item[\"id\"],\n",
    "                \"region\":             region_code,\n",
    "                \"fetch_date\":         datetime.utcnow().strftime(\"%Y-%m-%d\"),\n",
    "                # metadane\n",
    "                \"title\":              snippet.get(\"title\", \"\"),\n",
    "                \"description\":        snippet.get(\"description\", \"\")[:500],\n",
    "                \"channel_id\":         snippet.get(\"channelId\", \"\"),\n",
    "                \"channel_title\":      snippet.get(\"channelTitle\", \"\"),\n",
    "                \"category_id\":        snippet.get(\"categoryId\", \"\"),\n",
    "                \"category_name\":      CATEGORY_MAP.get(snippet.get(\"categoryId\", \"\"), \"Other\"),\n",
    "                \"published_at\":       snippet.get(\"publishedAt\", \"\"),\n",
    "                \"tags\":               \"|\".join(snippet.get(\"tags\", [])),\n",
    "                \"tag_count\":          len(snippet.get(\"tags\", [])),\n",
    "                \"default_language\":   snippet.get(\"defaultLanguage\", \"\"),\n",
    "                \"live_broadcast\":     snippet.get(\"liveBroadcastContent\", \"none\"),\n",
    "                # statystyki\n",
    "                \"view_count\":         int(stats.get(\"viewCount\",    0) or 0),\n",
    "                \"like_count\":         int(stats.get(\"likeCount\",    0) or 0),\n",
    "                \"comment_count\":      int(stats.get(\"commentCount\", 0) or 0),\n",
    "                \"comments_disabled\":  \"commentCount\" not in stats,\n",
    "                \"ratings_disabled\":   \"likeCount\"    not in stats,\n",
    "                # szczegóły\n",
    "                \"duration\":           content.get(\"duration\", \"\"),\n",
    "                \"definition\":         content.get(\"definition\", \"\"),\n",
    "                \"caption\":            content.get(\"caption\", \"false\"),\n",
    "                \"licensed_content\":   content.get(\"licensedContent\", False),\n",
    "                \"thumbnail_url\":      snippet.get(\"thumbnails\", {}).get(\"high\", {}).get(\"url\", \"\"),\n",
    "            })\n",
    "\n",
    "        next_page_token = resp.get(\"nextPageToken\")\n",
    "        if not next_page_token:\n",
    "            break\n",
    "        time.sleep(0.3)\n",
    "\n",
    "    return videos\n",
    "\n",
    "\n",
    "print(\"Funkcja fetch_trending gotowa\")"
   ]
  },
