   ],
   "source": [
    "# ── Pobieranie danych ─────────────────────────────────────────────────────────\n",
    "youtube = build(\"youtube\", \"v3\", developerKey=API_KEY)\n",
    "all_videos = []\n",
    "\n",
    "for region in tqdm(REGIONS, desc=\"Regiony\"):\n",
    "    print(f\"  Pobieram: {region}...\", end=\" \")\n",
    "    videos = fetch_trending(youtube, region, MAX_PAGES)\n",
    "    all_videos.extend(videos)\n",
    "\n",
    "    # Zapis surowego JSON dla każdego regionu\n",
    "    raw_path = RAW_DIR / f\"trending_{region}_{datetime.utcnow().strftime('%Y%m%d')}.json\"\n",
    "    with open(raw_path, \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(videos, f, ensure_ascii=False, indent=2)\n",
    "    print(f\"{len(videos)} filmów → {raw_path.name}\")\n",
    "\n",
    "print(f\"\\nŁącznie: {len(all_videos)} rekordów\")"
   ]
  },
