# Warstwa 1: Ingestion — Pobieranie danych z YouTube API

**Cel:** Pobranie danych o trendujących filmach z YouTube dla 5 regionów (PL, US, GB, DE, FR)  
**Formaty wyjściowe:** JSON (surowy), CSV (płaski), Parquet (kolumnowy)

## Jak uzyskać klucz API?
1. Wejdź na [console.cloud.google.com](https://console.cloud.google.com)
2. APIs & Services → Enable APIs → wyszukaj **YouTube Data API v3** → Enable
3. APIs & Services → Credentials → Create Credentials → API Key
4. Skopiuj klucz i wpisz go poniżej

import os
import json
import time
from datetime import datetime
from pathlib import Path

import pandas as pd
import pyarrow as pa
import pyarrow.parquet as pq
from googleapiclient.discovery import build
from tqdm.notebook import tqdm

# ── Konfiguracja ──────────────────────────────────────────────────────────────
API_KEY = "?"   # <-- zmień na swój klucz

REGIONS   = ["PL", "US", "GB", "DE", "FR"]
MAX_PAGES = 4          # 50 filmów na stronę × 4 = 200 filmów na region

RAW_DIR     = Path("../data/raw")
PARQUET_DIR = Path("../data/parquet")
RAW_DIR.mkdir(parents=True, exist_ok=True)
PARQUET_DIR.mkdir(parents=True, exist_ok=True)

CATEGORY_MAP = {
    "1":  "Film & Animation", "2":  "Autos & Vehicles",
    "10": "Music",            "15": "Pets & Animals",
    "17": "Sports",           "19": "Travel & Events",
    "20": "Gaming",           "22": "People & Blogs",
    "23": "Comedy",           "24": "Entertainment",
    "25": "News & Politics",  "26": "Howto & Style",
    "27": "Education",        "28": "Science & Technology",
    "29": "Nonprofits & Activism"
}

print("Konfiguracja OK")
def fetch_trending(youtube, region_code: str, max_pages: int) -> list[dict]:
    """Pobiera trendujące filmy dla danego regionu."""
    videos = []
    next_page_token = None

    for _ in range(max_pages):
        req = youtube.videos().list(
            part="snippet,statistics,contentDetails,status",
            chart="mostPopular",
            regionCode=region_code,
            maxResults=50,
            pageToken=next_page_token
        )
        resp = req.execute()

        for item in resp.get("items", []):
            snippet    = item.get("snippet", {})
            stats      = item.get("statistics", {})
            content    = item.get("contentDetails", {})

            videos.append({
                # identyfikatory
                "video_id":           item["id"],
                "region":             region_code,
                "fetch_date":         datetime.utcnow().strftime("%Y-%m-%d"),
                # metadane
                "title":              snippet.get("title", ""),
                "description":        snippet.get("description", "")[:500],
                "channel_id":         snippet.get("channelId", ""),
                "channel_title":      snippet.get("channelTitle", ""),
                "category_id":        snippet.get("categoryId", ""),
                "category_name":      CATEGORY_MAP.get(snippet.get("categoryId", ""), "Other"),
                "published_at":       snippet.get("publishedAt", ""),
                "tags":               "|".join(snippet.get("tags", [])),
                "tag_count":          len(snippet.get("tags", [])),
                "default_language":   snippet.get("defaultLanguage", ""),
                "live_broadcast":     snippet.get("liveBroadcastContent", "none"),
                # statystyki
                "view_count":         int(stats.get("viewCount",    0) or 0),
                "like_count":         int(stats.get("likeCount",    0) or 0),
                "comment_count":      int(stats.get("commentCount", 0) or 0),
                "comments_disabled":  "commentCount" not in stats,
                "ratings_disabled":   "likeCount"    not in stats,
                # szczegóły
                "duration":           content.get("duration", ""),
                "definition":         content.get("definition", ""),
                "caption":            content.get("caption", "false"),
                "licensed_content":   content.get("licensedContent", False),
                "thumbnail_url":      snippet.get("thumbnails", {}).get("high", {}).get("url", ""),
            })

        next_page_token = resp.get("nextPageToken")
        if not next_page_token:
            break
        time.sleep(0.3)

    return videos


print("Funkcja fetch_trending gotowa")
# ── Pobieranie danych ─────────────────────────────────────────────────────────
youtube = build("youtube", "v3", developerKey=API_KEY)
all_videos = []

for region in tqdm(REGIONS, desc="Regiony"):
    print(f"  Pobieram: {region}...", end=" ")
    videos = fetch_trending(youtube, region, MAX_PAGES)
    all_videos.extend(videos)

    # Zapis surowego JSON dla każdego regionu
    raw_path = RAW_DIR / f"trending_{region}_{datetime.utcnow().strftime('%Y%m%d')}.json"
    with open(raw_path, "w", encoding="utf-8") as f:
        json.dump(videos, f, ensure_ascii=False, indent=2)
    print(f"{len(videos)} filmów → {raw_path.name}")

print(f"\nŁącznie: {len(all_videos)} rekordów")
# ── Zapis do CSV ──────────────────────────────────────────────────────────────
df = pd.DataFrame(all_videos)

csv_path = RAW_DIR / "trending_all.csv"
df.to_csv(csv_path, index=False, encoding="utf-8-sig")
print(f"CSV zapisany: {csv_path}  ({df.shape[0]} wierszy × {df.shape[1]} kolumn)")

df.head(3)
# ── Zapis do Parquet (format kolumnowy) ───────────────────────────────────────
table = pa.Table.from_pandas(df)
parquet_path = PARQUET_DIR / "trending_raw.parquet"
pq.write_table(table, parquet_path, compression="snappy")

csv_size     = os.path.getsize(csv_path)     / 1024
parquet_size = os.path.getsize(parquet_path) / 1024
print(f"Parquet zapisany: {parquet_path}")
print(f"  CSV:     {csv_size:.1f} KB")
print(f"  Parquet: {parquet_size:.1f} KB  (kompresja Snappy)")
print(f"  Współczynnik kompresji: {csv_size/parquet_size:.1f}x")
# ── Podsumowanie pobranych danych ─────────────────────────────────────────────
print("=" * 50)
print("PODSUMOWANIE INGESTION")
print("=" * 50)
print(f"Regiony:          {df['region'].unique().tolist()}")
print(f"Łączne rekordy:   {len(df):,}")
print(f"Atrybuty:         {len(df.columns)}")
print()
print("Filmy per region:")
print(df['region'].value_counts().to_string())
print()
print("Pliki wyjściowe:")
for f in list(RAW_DIR.glob("*.json")) + [csv_path]:
    print(f"  {f.name}")
print(f"  {parquet_path.name}")
